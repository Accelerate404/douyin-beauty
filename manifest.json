{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.7.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["*://*.douyin.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/main.js"],
      "css": ["content/theme.css", "content/profile.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
